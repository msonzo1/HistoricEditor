<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema SCURO -->
    <SolidColorBrush x:Key="AppBackground" Color="#161616" />
    <SolidColorBrush x:Key="AppSurface" Color="#1F1F1F" />
    <SolidColorBrush x:Key="AppSurfaceAlt" Color="#2B2B2B" />
    <SolidColorBrush x:Key="AppBorder" Color="#3A3A3A" />
    <SolidColorBrush x:Key="LineBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="AppControlBg" Color="#262626" />
    <SolidColorBrush x:Key="AppControlBorder" Color="#464646" />

    <SolidColorBrush x:Key="InkBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="#BEBEBE" />
    <SolidColorBrush x:Key="QuietBrush" Color="#8F8F8F" />

    <SolidColorBrush x:Key="GreenBrush" Color="#5BA882" />
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#6DBB94" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#101010" />
    <SolidColorBrush x:Key="SignalBrush" Color="#E8906F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E07257" />

    <SolidColorBrush x:Key="SelectionBrush" Color="#33423A" />

    <!-- Caselle dell'albero genealogico: azzurrino per i maschi, rosino per le femmine -->
    <SolidColorBrush x:Key="MaleCardBrush" Color="#1F3442" />
    <SolidColorBrush x:Key="FemaleCardBrush" Color="#422633" />

    <!-- Barra del titolo e colonna laterale: scure in entrambi i temi -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#0E0E0E" />
    <SolidColorBrush x:Key="TitleHoverBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="TitleTextBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0E0E0E" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="SidebarFaintBrush" Color="#848484" />
</ResourceDictionary>
