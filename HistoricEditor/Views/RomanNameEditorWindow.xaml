<Window x:Class="HistoricEditor.RomanNameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HistoricEditor"
        Title="Nome romano"
        SizeToContent="Height" Width="640" MaxHeight="820"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource SignalBrush}" />
            <Setter Property="Margin" Value="0,4,0,6" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="18">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annulla" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="Salva" Click="Save_Click" Padding="14,7" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <TextBlock x:Name="EditorMessage" Foreground="{DynamicResource SignalBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Nome portato in un periodo della vita. Ogni riga è una parte del nome, in latino e in italiano, nell'ordine in cui si legge: il latino compone il nome latino e la forma epigrafica, l'italiano il nome mostrato. Scrivendo il latino, l'italiano vuoto viene proposto da solo. Anche la filiazione («C. f.», «Divi filius») e la tribù («Fabia») sono righe, nel punto in cui si leggono: compaiono solo nella forma epigrafica, abbreviate." FontSize="11" Foreground="{DynamicResource QuietBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                <TextBlock Text="PARTI DEL NOME" Style="{StaticResource SectionTitle}" />
                <DataGrid x:Name="PartsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                          HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="38" MaxHeight="300" SelectionChanged="PartsGrid_SelectionChanged" AutomationProperties.Name="Parti del nome">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Parte" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{x:Static local:TipiParteNome.All}" SelectedItem="{Binding Tipo, UpdateSourceTrigger=PropertyChanged}" Margin="2" VerticalContentAlignment="Center" AutomationProperties.Name="Tipo della parte" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Latino" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Latino, UpdateSourceTrigger=PropertyChanged}" Margin="2" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" VerticalContentAlignment="Center" AutomationProperties.Name="Parte in latino" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Italiano" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Italiano, UpdateSourceTrigger=PropertyChanged}" Margin="2" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" VerticalContentAlignment="Center" AutomationProperties.Name="Parte in italiano" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddPartButton" Content="+ Aggiungi parte ▾" Click="AddPart_Click" Padding="12,5" ToolTip="Aggiunge un praenomen, un nomen, la filiazione (composta dal praenomen del padre, se è noto), la tribù, un cognomen, un agnomen o un titolo" AutomationProperties.Name="Aggiungi una parte del nome">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AddPartMenu" />
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="MoveUpButton" Content="↑" Click="MoveUp_Click" Padding="12,5" Margin="8,0,0,0" ToolTip="Sposta la parte prima" AutomationProperties.Name="Sposta la parte prima" />
                    <Button x:Name="MoveDownButton" Content="↓" Click="MoveDown_Click" Padding="12,5" Margin="4,0,0,0" ToolTip="Sposta la parte dopo" AutomationProperties.Name="Sposta la parte dopo" />
                    <Button x:Name="RemovePartButton" Content="Elimina" Click="RemovePart_Click" Padding="12,5" Margin="8,0,0,0" AutomationProperties.Name="Elimina la parte selezionata" />
                </StackPanel>

                <StackPanel Margin="0,14,0,6">
                    <Label Content="Nome latino li_bero" Target="{Binding ElementName=LatinNameInput}" />
                    <TextBox x:Name="LatinNameInput" Height="34" TextChanged="Part_Changed" AutomationProperties.Name="Nome latino libero"
                             ToolTip="Facoltativo: la forma latina quando non si compone bene dalle parti (donne, liberti, nomi grecanici). Se indicato, è il nome latino mostrato" />
                </StackPanel>
                <TextBlock x:Name="LatinPreview" FontSize="12" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="2,2,0,10" AutomationProperties.LiveSetting="Polite" />

                <TextBlock Text="PERIODO" Style="{StaticResource SectionTitle}" Margin="0,8,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="_Dal" Target="{Binding ElementName=FromInput}" />
                        <TextBox x:Name="FromInput" Height="34" AutomationProperties.Name="Dal" ToolTip="Anno o data di inizio, ad esempio «138» o «44 a.C.»" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="_Al" Target="{Binding ElementName=ToInput}" />
                        <TextBox x:Name="ToInput" Height="34" AutomationProperties.Name="Al" ToolTip="Anno o data di fine; vuoto se è il nome portato fino alla morte" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <Label Content="_Motivo" Target="{Binding ElementName=ReasonInput}" />
                        <ComboBox x:Name="ReasonInput" Height="34" IsEditable="True" VerticalContentAlignment="Center" ItemsSource="{x:Static local:RomanNameRecord.Reasons}" AutomationProperties.Name="Motivo del nome" />
                    </StackPanel>
                </Grid>

                <!-- Il nome nelle altre lingue: nome completo per lingua, modificabile solo nel modulo della lingua. -->
                <StackPanel x:Name="LanguagesPanel" Margin="0,16,0,0">
                    <TextBlock Text="IN ALTRE LINGUE" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Il nome nelle altre lingue, composto dalle stesse parti. Ogni lingua si modifica nel suo modulo (doppio clic o «Modifica…»)." FontSize="11" Foreground="{DynamicResource QuietBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <DataGrid x:Name="LanguagesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" MinHeight="40" MaxHeight="200"
                              MouseDoubleClick="LanguagesGrid_MouseDoubleClick" SelectionChanged="LanguagesGrid_SelectionChanged" AutomationProperties.Name="Il nome nelle altre lingue">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lingua" Binding="{Binding Name}" Width="140" />
                            <DataGridTextColumn Header="Nome completo" Binding="{Binding FullName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AddLanguageButton" Content="+ Aggiungi lingua ▾" Click="AddLanguage_Click" Padding="12,5" AutomationProperties.Name="Aggiungi una lingua al nome">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="AddLanguageMenu" />
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="EditLanguageButton" Content="Modifica…" Click="EditLanguage_Click" Padding="12,5" Margin="8,0,0,0" AutomationProperties.Name="Modifica il nome nella lingua selezionata" />
                        <Button x:Name="RemoveLanguageButton" Content="Elimina" Click="RemoveLanguage_Click" Padding="12,5" Margin="8,0,0,0" AutomationProperties.Name="Elimina le forme della lingua selezionata" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
