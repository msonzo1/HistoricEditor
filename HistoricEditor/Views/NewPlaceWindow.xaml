<Window x:Class="HistoricEditor.NewPlaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuovo luogo"
        SizeToContent="Height" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18">
        <TextBlock Text="Che tipo di luogo vuoi aggiungere?" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,14" />

        <RadioButton x:Name="CurrentOption" IsChecked="True" Margin="0,0,0,12" AutomationProperties.Name="Luogo attuale">
            <StackPanel>
                <TextBlock Text="Luogo attuale" FontWeight="SemiBold" />
                <TextBlock Text="Comune, provincia, regione… secondo la suddivisione amministrativa di oggi." Foreground="{DynamicResource QuietBrush}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="HistoricOption" Margin="0,0,0,12" AutomationProperties.Name="Luogo storico">
            <StackPanel>
                <TextBlock Text="Luogo storico" FontWeight="SemiBold" />
                <TextBlock Text="Stato, ducato, contea… non più esistente, con il suo periodo." Foreground="{DynamicResource QuietBrush}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="SpecificOption" Margin="0,0,0,12" AutomationProperties.Name="Luogo specifico">
            <StackPanel>
                <TextBlock Text="Luogo specifico" FontWeight="SemiBold" />
                <TextBlock Text="Edificio o punto preciso (monastero, reggia, chiesa…) contenuto in un luogo." Foreground="{DynamicResource QuietBrush}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
        </RadioButton>

        <TextBlock x:Name="ContextText" Foreground="{DynamicResource InkSoftBrush}" FontSize="11" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Annulla" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
            <Button Content="Continua" IsDefault="True" Click="Continue_Click" Padding="14,7" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
