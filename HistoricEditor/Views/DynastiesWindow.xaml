<Window x:Class="HistoricEditor.DynastiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dinastie"
        Width="760" Height="480" MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Una dinastia può essere ramo di un’altra (es. «Asburgo di Spagna» ramo di «Asburgo»). Nella vista Famiglie i rami compaiono dentro la dinastia principale; le persone si collegano tramite il campo Famiglia." Foreground="{DynamicResource QuietBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <DockPanel Grid.Row="1" Grid.Column="0">
            <Label DockPanel.Dock="Top" Content="_Dinastie registrate" Target="{Binding ElementName=DynastyList}" />
            <Button DockPanel.Dock="Bottom" Content="_Nuova dinastia" Click="New_Click" Padding="14,7" Margin="0,8,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Nuova dinastia" />
            <ListBox x:Name="DynastyList" DisplayMemberPath="Percorso" SelectionChanged="DynastyList_SelectionChanged" AutomationProperties.Name="Dinastie registrate" />
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.Column="2">
            <Label Content="N_ome" Target="{Binding ElementName=NameBox}" />
            <ComboBox x:Name="NameBox" IsEditable="True" Margin="0,0,0,10" AutomationProperties.Name="Nome della dinastia" ToolTip="Puoi scegliere una famiglia già usata nelle schede" />

            <Label Content="_Ramo di" Target="{Binding ElementName=ParentBox}" />
            <ComboBox x:Name="ParentBox" DisplayMemberPath="Percorso" Margin="0,0,0,10" AutomationProperties.Name="Dinastia principale di cui è ramo" />

            <Label Content="_Wikidata" Target="{Binding ElementName=WikidataBox}" />
            <TextBox x:Name="WikidataBox" Padding="8,6" Margin="0,0,0,10" AutomationProperties.Name="Identificativo Wikidata della dinastia" />

            <Label Content="No_te" Target="{Binding ElementName=NoteBox}" />
            <TextBox x:Name="NoteBox" Height="70" Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Note sulla dinastia" />
        </StackPanel>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="DeleteButton" Content="_Elimina" Click="Delete_Click" Padding="14,7" Margin="0,0,8,0" IsEnabled="False" AutomationProperties.Name="Elimina dinastia" />
                <Button Content="_Salva" IsDefault="True" Click="Save_Click" Padding="14,7" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Salva dinastia" />
                <Button Content="Chiudi" IsCancel="True" Padding="14,7" />
            </StackPanel>
            <TextBlock x:Name="EditorMessage" Foreground="{DynamicResource SignalBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Window>
