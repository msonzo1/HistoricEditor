<UserControl x:Class="HistoricEditor.PlacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HistoricEditor"
             Foreground="{DynamicResource InkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
            <TextBlock Text="ARCHIVIO DEI LUOGHI" Foreground="{DynamicResource SignalBrush}" FontFamily="Consolas" FontSize="10" />
            <TextBlock Text="I luoghi" Foreground="{DynamicResource InkBrush}" FontFamily="Georgia" FontSize="23" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16" VerticalAlignment="Bottom">
            <TextBlock Text="DETTAGLIO LUOGO" Foreground="{DynamicResource SignalBrush}" FontFamily="Consolas" FontSize="10" />
        </StackPanel>

        <local:PlaceTreeControl x:Name="PlacesTree" Grid.Row="1" Grid.Column="0" />

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Nuovo luogo…" Click="NewPlace_Click" Padding="12,7" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="DeleteButton" Content="Elimina" Click="Delete_Click" Padding="12,7" Style="{StaticResource DangerButton}" IsEnabled="False" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource AppBorder}" Background="{DynamicResource AppSurface}" BorderThickness="1" CornerRadius="10" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EditPanel" IsEnabled="False">
                    <TextBlock x:Name="PathText" Foreground="{DynamicResource InkSoftBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <Label Content="Tipo" />
                    <TextBlock x:Name="TipoText" Margin="0,0,0,10" Foreground="{DynamicResource InkBrush}" />

                    <Label Content="Nome" Target="{Binding ElementName=NomeBox}" />
                    <TextBox x:Name="NomeBox" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="Latitudine" Target="{Binding ElementName=LatBox}" />
                            <TextBox x:Name="LatBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Longitudine" Target="{Binding ElementName=LonBox}" />
                            <TextBox x:Name="LonBox" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="StoricoBox" Content="Luogo storico (non più esistente)" Margin="0,0,0,10" Checked="StoricoBox_Changed" Unchecked="StoricoBox_Changed" />
                    <CheckBox x:Name="SenzaLivelloBox" Margin="0,0,0,10" Visibility="Collapsed" />

                    <StackPanel x:Name="PeriodoPanel" Visibility="Collapsed">
                        <Label Content="Periodo (es. 1115–1797)" Target="{Binding ElementName=PeriodoBox}" />
                        <TextBox x:Name="PeriodoBox" Margin="0,0,0,10" />
                    </StackPanel>

                    <Label Content="Note" Target="{Binding ElementName=NoteBox}" />
                    <TextBox x:Name="NoteBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,0,0,12" />

                    <Button Content="Salva modifiche" Click="Save_Click" Padding="12,7" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0">
            <Button x:Name="EditSpecificButton" DockPanel.Dock="Right" Content="Modifica luogo specifico…" Click="EditSpecific_Click" Padding="12,7" IsEnabled="False" />
            <TextBlock x:Name="ManagerMessage" Foreground="{DynamicResource SignalBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</UserControl>
