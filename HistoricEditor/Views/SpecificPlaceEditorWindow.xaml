<Window x:Class="HistoricEditor.SpecificPlaceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luogo specifico"
        Height="680" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <Label Content="Nome *" Target="{Binding ElementName=NomeBox}" />
                <TextBox x:Name="NomeBox" Padding="8,6" Margin="0,0,0,10" AutomationProperties.Name="Nome del luogo specifico" />

                <Label Content="Tipo (es. monastero, reggia, chiesa)" Target="{Binding ElementName=TipoBox}" />
                <ComboBox x:Name="TipoBox" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,0,10" AutomationProperties.Name="Tipo del luogo specifico" />

                <Label Content="Luogo amministrativo *" Target="{Binding ElementName=ClassicText}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Cambia…" Click="ChangeClassic_Click" Margin="8,0,0,0" Padding="10,6" AutomationProperties.Name="Cambia luogo amministrativo" />
                    <TextBox x:Name="ClassicText" IsReadOnly="True" Padding="8,6" AutomationProperties.Name="Luogo amministrativo" />
                </DockPanel>
                <TextBlock x:Name="UsageText" Foreground="{DynamicResource QuietBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />

                <Label Content="Via / indirizzo" Target="{Binding ElementName=IndirizzoBox}" />
                <TextBox x:Name="IndirizzoBox" Padding="8,6" Margin="0,0,0,10" AutomationProperties.Name="Via o indirizzo" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Condizione" Target="{Binding ElementName=CondizioneBox}" />
                        <ComboBox x:Name="CondizioneBox" AutomationProperties.Name="Condizione del luogo" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Data di distruzione" Target="{Binding ElementName=DataDistruzioneBox}" />
                        <TextBox x:Name="DataDistruzioneBox" Padding="8,6" AutomationProperties.Name="Data di distruzione" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Latitudine" Target="{Binding ElementName=LatBox}" />
                        <TextBox x:Name="LatBox" Padding="8,6" AutomationProperties.Name="Latitudine" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Longitudine" Target="{Binding ElementName=LonBox}" />
                        <TextBox x:Name="LonBox" Padding="8,6" AutomationProperties.Name="Longitudine" />
                    </StackPanel>
                </Grid>

                <Label Content="Codice Wikidata" Target="{Binding ElementName=WikidataBox}" />
                <TextBox x:Name="WikidataBox" Padding="8,6" Margin="0,0,0,10" AutomationProperties.Name="Codice Wikidata" />

                <Label Content="Note" Target="{Binding ElementName=NoteBox}" />
                <TextBox x:Name="NoteBox" Height="70" Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Note" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annulla" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="Salva" IsDefault="True" Click="Save_Click" Padding="14,7" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <TextBlock x:Name="EditorMessage" Foreground="{DynamicResource SignalBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
