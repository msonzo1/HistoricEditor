<Window x:Class="HistoricEditor.PlacePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HistoricEditor"
        Title="Scegli un luogo"
        Height="640" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,10" />

        <local:PlaceTreeControl x:Name="PlacesTree" Grid.Row="1" />

        <!-- Il messaggio sta sotto la selezione, non nella riga dei pulsanti: lì andava a capo in una colonna stretta e li
             allungava (2026-11-16). -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="SelectionText" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="PickerMessage" Foreground="{DynamicResource SignalBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Nuovo luogo…" Click="NewPlace_Click" Padding="10,6" />
            <Button x:Name="EditButton" DockPanel.Dock="Left" Content="Modifica luogo…" Click="EditPlace_Click" Padding="10,6" Margin="8,0,0,0" IsEnabled="False"
                    ToolTip="Modifica il luogo selezionato (F2)" AutomationProperties.Name="Modifica il luogo selezionato" AutomationProperties.AcceleratorKey="F2" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="ClearButton" Content="Nessun luogo" Click="Clear_Click" Padding="12,7" Margin="0,0,8,0" />
                <Button Content="Annulla" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="Seleziona" IsDefault="True" Click="Select_Click" Padding="14,7" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
