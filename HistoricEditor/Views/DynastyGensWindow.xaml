<Window x:Class="HistoricEditor.DynastyGensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dinastia e gens"
        SizeToContent="Height" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18">
        <TextBlock Text="La gens è quella di nascita, con i suoi rami (es. «gens Ulpia; Ulpii Traiani»); la dinastia è la casata regnante, che può comprendere più gentes (es. «Dinastia Nerva-Antonina»). Più nomi si separano con «;»; un nome nuovo viene registrato al salvataggio della scheda." FontSize="11" Foreground="{DynamicResource QuietBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Label Content="_Dinastia" Target="{Binding ElementName=DynastyInput}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Dinastia…" Click="EditDynasty_Click" Height="34" Padding="10,0" Margin="6,0,0,0" ToolTip="Modifica la dinastia: ramo di, Wikidata, note" AutomationProperties.Name="Modifica la dinastia" />
            <ComboBox x:Name="DynastyInput" Height="34" IsEditable="True" IsTextSearchEnabled="True" VerticalContentAlignment="Center" TextBoxBase.TextChanged="Input_TextChanged" AutomationProperties.Name="Dinastia" AutomationProperties.HelpText="{Binding Text, ElementName=DynastyPathText}" />
        </DockPanel>
        <TextBlock x:Name="DynastyPathText" FontSize="11" Foreground="{DynamicResource QuietBrush}" TextWrapping="Wrap" Margin="2,4,0,12" />

        <Label Content="_Gens" Target="{Binding ElementName=GensInput}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Gens…" Click="EditGens_Click" Height="34" Padding="10,0" Margin="6,0,0,0" ToolTip="Modifica la gens: ramo di, Wikidata, note" AutomationProperties.Name="Modifica la gens" />
            <ComboBox x:Name="GensInput" Height="34" IsEditable="True" IsTextSearchEnabled="True" VerticalContentAlignment="Center" TextBoxBase.TextChanged="Input_TextChanged" AutomationProperties.Name="Gens" AutomationProperties.HelpText="{Binding Text, ElementName=GensPathText}" />
        </DockPanel>
        <TextBlock x:Name="GensPathText" FontSize="11" Foreground="{DynamicResource QuietBrush}" TextWrapping="Wrap" Margin="2,4,0,0" />

        <DockPanel Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annulla" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="Salva" IsDefault="True" Click="Save_Click" Padding="14,7" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <TextBlock x:Name="EditorMessage" Foreground="{DynamicResource SignalBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>
    </StackPanel>
</Window>
