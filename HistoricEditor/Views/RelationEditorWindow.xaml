<Window x:Class="HistoricEditor.RelationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relazione"
        SizeToContent="Height" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18">
        <TextBlock x:Name="HeaderText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Label x:Name="TipoLabel" Content="_Relazione" Target="{Binding ElementName=TipoBox}" />
        <ComboBox x:Name="TipoBox" IsEditable="True" Margin="0,0,0,4" AutomationProperties.Name="Relazione"
                  AutomationProperties.HelpText="Scegli una voce dall’elenco oppure scrivi un altro tipo di relazione"
                  ToolTip="Scegli una voce dall’elenco oppure scrivi un altro tipo di relazione"
                  TextBoxBase.TextChanged="TipoBox_TextChanged" SelectionChanged="TipoBox_SelectionChanged" />
        <TextBlock x:Name="PreviewText" Foreground="{DynamicResource QuietBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="_Inizio" Target="{Binding ElementName=InizioBox}" />
                <TextBox x:Name="InizioBox" Padding="8,6" AutomationProperties.Name="Inizio della relazione" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="_Fine" Target="{Binding ElementName=FineBox}" />
                <TextBox x:Name="FineBox" Padding="8,6" AutomationProperties.Name="Fine della relazione" />
            </StackPanel>
        </Grid>

        <Label Content="_Note" Target="{Binding ElementName=NoteBox}" />
        <TextBox x:Name="NoteBox" Height="60" Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Note sulla relazione" />

        <DockPanel Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annulla" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="Salva" IsDefault="True" Click="Save_Click" Padding="14,7" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <TextBlock x:Name="EditorMessage" Foreground="{DynamicResource SignalBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Assertive" />
        </DockPanel>
    </StackPanel>
</Window>
