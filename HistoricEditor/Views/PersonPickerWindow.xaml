<Window x:Class="HistoricEditor.PersonPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scegli una persona"
        Height="580" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Label Content="Cerca nell’archivio" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,4" />
            <TextBox x:Name="SearchBox" Padding="8,6" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Cerca persona" />
        </StackPanel>

        <ListBox x:Name="PeopleList" Grid.Row="1" Margin="0,10,0,0" DisplayMemberPath="Etichetta" MouseDoubleClick="PeopleList_MouseDoubleClick" AutomationProperties.Name="Persone in archivio" />

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Label Content="Non è in archivio? Crea una nuova scheda con il nome:" Target="{Binding ElementName=NewNameBox}" Padding="0,0,0,4" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Crea e seleziona" Click="Create_Click" Margin="8,0,0,0" Padding="10,6" />
                <TextBox x:Name="NewNameBox" Padding="8,6" AutomationProperties.Name="Nome della nuova scheda" />
            </DockPanel>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annulla" IsCancel="True" Padding="14,7" Margin="0,0,8,0" />
                <Button Content="Seleziona" IsDefault="True" Click="Select_Click" Padding="14,7" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <TextBlock x:Name="PickerMessage" Foreground="{DynamicResource SignalBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
