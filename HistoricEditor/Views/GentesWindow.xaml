<Window x:Class="HistoricEditor.GentesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HistoricEditor"
        Title="Gentes e rami"
        Width="820" Height="680" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText" Grid.Row="0" Grid.ColumnSpan="3" Foreground="{DynamicResource QuietBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="La gens è la stirpe (Iulia), il ramo una sua suddivisione (Caesares). Si scrivono le forme latine come sono, senza ricavarle: i nomi composti («Gens Iulia», «Iulii Caesares») si leggono dal plurale della gens e da quello del ramo. Le forme italiane sono facoltative." />

        <DockPanel Grid.Row="1" Grid.Column="0">
            <Label DockPanel.Dock="Top" Content="_Gentes registrate" Target="{Binding ElementName=GensTree}" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="_Nuova gens" Click="NewGens_Click" Padding="12,7" AutomationProperties.Name="Nuova gens" />
                <Button x:Name="NewRamoButton" Content="Nuovo _ramo" Click="NewRamo_Click" Padding="12,7" Margin="8,0,0,0" IsEnabled="False"
                        ToolTip="Nuovo ramo della gens selezionata" AutomationProperties.Name="Nuovo ramo della gens selezionata" />
            </StackPanel>
            <TreeView x:Name="GensTree" SelectedItemChanged="GensTree_SelectedItemChanged" AutomationProperties.Name="Gentes registrate">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        <EventSetter Event="MouseDoubleClick" Handler="TreeItem_MouseDoubleClick" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Rami}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Etichetta}" Padding="2,3" />
                            <TextBlock Text="{Binding Nota}" Foreground="{DynamicResource QuietBrush}" FontSize="10" Margin="8,5,0,0" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBlock x:Name="UsageText" Foreground="{DynamicResource QuietBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

                <!-- Gens -->
                <StackPanel x:Name="GensPanel">
                    <TextBlock Text="Gens" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
                    <Label Content="Nome _latino *" Target="{Binding ElementName=GensNameBox}" />
                    <TextBox x:Name="GensNameBox" Padding="8,6" Margin="0,0,0,10" TextChanged="Field_Changed" AutomationProperties.Name="Nome latino della gens" ToolTip="Per esempio «Iulia»" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="No_men (maschile singolare)" Target="{Binding ElementName=NomenBox}" />
                            <TextBox x:Name="NomenBox" Padding="8,6" TextChanged="Field_Changed" AutomationProperties.Name="Nomen maschile singolare" ToolTip="Per esempio «Iulius»" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="_Plurale" Target="{Binding ElementName=GensPluralBox}" />
                            <TextBox x:Name="GensPluralBox" Padding="8,6" TextChanged="Field_Changed" AutomationProperties.Name="Nome plurale della gens" ToolTip="Per esempio «Iulii»" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="Nome _italiano" Target="{Binding ElementName=GensItalianBox}" />
                            <TextBox x:Name="GensItalianBox" Padding="8,6" TextChanged="Field_Changed" AutomationProperties.Name="Nome italiano della gens" ToolTip="Per esempio «Giulia»" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Plurale i_taliano" Target="{Binding ElementName=GensItalianPluralBox}" />
                            <TextBox x:Name="GensItalianPluralBox" Padding="8,6" TextChanged="Field_Changed" AutomationProperties.Name="Plurale italiano della gens" ToolTip="Per esempio «Giulii»" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Ramo -->
                <StackPanel x:Name="RamoPanel" Visibility="Collapsed">
                    <TextBlock Text="Ramo" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
                    <Label Content="_Gens" Target="{Binding ElementName=RamoGensBox}" />
                    <ComboBox x:Name="RamoGensBox" DisplayMemberPath="Etichetta" Margin="0,0,0,10" SelectionChanged="Field_Changed" AutomationProperties.Name="Gens del ramo" />
                    <!-- Ramo in attesa: la gens non si cambia qui. -->
                    <TextBlock x:Name="RamoGensText" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="2,0,0,10" Visibility="Collapsed" AutomationProperties.Name="Gens del ramo" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="P_lurale *" Target="{Binding ElementName=RamoPluralBox}" />
                            <TextBox x:Name="RamoPluralBox" Padding="8,6" TextChanged="Field_Changed" AutomationProperties.Name="Nome plurale del ramo" ToolTip="Per esempio «Caesares»" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="_Cognomen (singolare, facoltativo)" Target="{Binding ElementName=CognomenBox}" />
                            <TextBox x:Name="CognomenBox" Padding="8,6" TextChanged="Field_Changed" AutomationProperties.Name="Cognomen singolare del ramo" ToolTip="Per esempio «Caesar»" />
                        </StackPanel>
                    </Grid>
                    <Label Content="Plurale ital_iano" Target="{Binding ElementName=RamoItalianBox}" />
                    <TextBox x:Name="RamoItalianBox" Padding="8,6" Margin="0,0,0,10" TextChanged="Field_Changed" AutomationProperties.Name="Plurale italiano del ramo" ToolTip="Per esempio «Cesari»" />
                </StackPanel>

                <TextBlock x:Name="PreviewText" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />

                <Label Content="_Wikidata" Target="{Binding ElementName=WikidataBox}" />
                <TextBox x:Name="WikidataBox" Padding="8,6" Margin="0,0,0,10" AutomationProperties.Name="Identificativo Wikidata" />

                <Label Content="No_te" Target="{Binding ElementName=NoteBox}" />
                <local:RichNoteEditor x:Name="NoteBox" EditorHeight="90" AccessibleName="Note" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="DeleteButton" Content="_Elimina" Click="Delete_Click" Padding="14,7" Margin="0,0,8,0" IsEnabled="False" AutomationProperties.Name="Elimina la gens o il ramo" />
                <Button x:Name="SaveButton" Content="_Salva" Click="Save_Click" Padding="14,7" Margin="0,0,8,0" AutomationProperties.Name="Salva la gens o il ramo" />
                <Button x:Name="SelectButton" Content="Seleziona" Click="Select_Click" Padding="14,7" Margin="0,0,8,0" Visibility="Collapsed" Style="{StaticResource PrimaryButton}"
                        AutomationProperties.Name="Seleziona la gens o il ramo per la scheda" />
                <Button x:Name="CloseButton" Content="Chiudi" IsCancel="True" Padding="14,7" />
            </StackPanel>
            <TextBlock x:Name="EditorMessage" Foreground="{DynamicResource SignalBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Window>
