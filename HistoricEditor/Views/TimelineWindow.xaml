<Window x:Class="HistoricEditor.TimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linea del tempo"
        Width="1200" Height="800" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <RadioButton x:Name="PersonMode" GroupName="TimelineScope" Content="_Personaggio" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="True" Checked="Scope_Changed" />
            <ComboBox x:Name="PersonBox" Grid.Column="1" IsTextSearchEnabled="True" SelectionChanged="Scope_Changed" AutomationProperties.Name="Personaggio della linea del tempo" AutomationProperties.LabeledBy="{Binding ElementName=PersonMode}" />
            <CheckBox x:Name="RelativesCheck" Grid.Column="2" Content="Includi _familiari (genitori, coniugi, figli)" VerticalAlignment="Center" Margin="12,0,0,0" Checked="Scope_Changed" Unchecked="Scope_Changed" />
            <RadioButton x:Name="FamilyMode" Grid.Row="1" GroupName="TimelineScope" Content="_Dinastia o famiglia" VerticalAlignment="Center" Margin="0,8,10,0" Checked="Scope_Changed" />
            <ComboBox x:Name="FamilyBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsTextSearchEnabled="True" IsEnabled="False" SelectionChanged="Scope_Changed" AutomationProperties.Name="Dinastia o famiglia della linea del tempo" AutomationProperties.LabeledBy="{Binding ElementName=FamilyMode}" AutomationProperties.HelpText="Una dinastia comprende anche i suoi rami" />
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,10,0,6" VerticalAlignment="Center">
            <TextBlock Text="Mostra:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource QuietBrush}" />
            <CheckBox x:Name="ShowLifeCheck" Content="_Nascite e morti" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <CheckBox x:Name="ShowOfficesCheck" Content="_Cariche" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <CheckBox x:Name="ShowUnionsCheck" Content="_Unioni" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <CheckBox x:Name="ShowEventsCheck" Content="_Eventi" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <Label Content="_Zoom" Target="{Binding ElementName=ZoomSlider}" Padding="0,0,6,0" VerticalAlignment="Center" />
            <Slider x:Name="ZoomSlider" Width="180" Minimum="0.5" Maximum="40" Value="8" SmallChange="0.5" LargeChange="4" VerticalAlignment="Center" ValueChanged="Zoom_Changed"
                    AutomationProperties.Name="Zoom: pixel per anno" />
            <Button Content="Ada_tta alla finestra" Margin="10,0,0,0" Padding="10,3" Click="Fit_Click" />
        </WrapPanel>

        <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Background="{DynamicResource AppSurface}">
            <Grid>
                <ScrollViewer x:Name="ChartScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="True"
                              AutomationProperties.Name="Grafico della linea del tempo"
                              AutomationProperties.HelpText="Una corsia per persona: barre per la vita e le cariche, punti per le voci. Lo stesso contenuto è nell’elenco cronologico.">
                    <Canvas x:Name="Chart" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                <TextBlock x:Name="ChartEmpty" Margin="16" TextWrapping="Wrap" Foreground="{DynamicResource QuietBrush}" Visibility="Collapsed"
                           Text="Nessuna data con anno riconoscibile da disegnare." />
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,3">
            <Label Content="E_lenco cronologico" Target="{Binding ElementName=TimelineGrid}" Padding="0" VerticalAlignment="Bottom" />
            <TextBlock x:Name="SummaryText" Margin="12,0,0,0" VerticalAlignment="Bottom" Foreground="{DynamicResource QuietBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <DataGrid x:Name="TimelineGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  SelectionChanged="TimelineGrid_SelectionChanged" MouseDoubleClick="TimelineGrid_MouseDoubleClick" PreviewKeyDown="TimelineGrid_PreviewKeyDown"
                  AutomationProperties.Name="Elenco cronologico" AutomationProperties.HelpText="Invio o doppio clic per aprire la scheda o l’evento">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Etichetta}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Anno" Binding="{Binding AnnoTesto}" Width="80" />
                <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="1.3*" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="1*" />
                <DataGridTextColumn Header="Descrizione" Binding="{Binding Descrizione}" Width="2*" />
                <DataGridTextColumn Header="Persone" Binding="{Binding Persone}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Chiudi" IsCancel="True" Padding="14,7" />
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copia elenc_o" Click="Copy_Click" Padding="12,6" Margin="0,0,8,0" AutomationProperties.Name="Copia l’elenco cronologico negli appunti" />
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="_Apri" Click="Open_Click" IsEnabled="False" Padding="12,6" Margin="0,0,8,0" AutomationProperties.Name="Apri la scheda o l’evento selezionato" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource QuietBrush}" FontSize="11" AutomationProperties.LiveSetting="Polite"
                       Text="Le date sono ordinate per anno moderno, tenendo conto dello stile di inizio dell’anno; le voci senza anno riconoscibile sono in fondo." />
        </DockPanel>
    </Grid>
</Window>
