<Window x:Class="HistoricEditor.ArtworkViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HistoricEditor"
        Title="Opera d'arte"
        Height="760" Width="860"
        MinHeight="480" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="26,24,26,16">
            <TextBlock Text="OPERA D'ARTE" Style="{StaticResource SectionKicker}" />
            <TextBlock x:Name="HeaderText" FontFamily="Georgia" FontSize="26" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="HeaderSubtitle" Foreground="{DynamicResource QuietBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,16,0" Focusable="False">
            <StackPanel Margin="0,0,10,0">
                <Border x:Name="ImageCard" Style="{StaticResource SheetCard}">
                    <StackPanel>
                        <Image x:Name="ArtworkImage" MaxHeight="420" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Button Content="Apri a _grandezza piena" Click="OpenImage_Click" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,10,0,0" ToolTip="Apre l'immagine nel visualizzatore di Windows" AutomationProperties.Name="Apri l'immagine a grandezza piena" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SheetCard}">
                    <StackPanel>
                        <TextBlock Text="DATI PRINCIPALI" Style="{StaticResource SheetSectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl x:Name="MainList" ItemTemplate="{StaticResource SheetFieldTemplate}" Focusable="False" />
                        <TextBlock x:Name="MainEmptyText" Text="Nessun dato oltre al titolo." Style="{StaticResource SheetEmpty}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SheetCard}">
                    <StackPanel>
                        <TextBlock Text="ARTISTI, COMMITTENTI E SOGGETTI" Style="{StaticResource SheetSectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Name="NoPeopleText" Text="Nessun personaggio collegato." Style="{StaticResource SheetEmpty}" />
                        <ItemsControl x:Name="PeopleList" Focusable="False" AutomationProperties.Name="Personaggi collegati all'opera">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Etichetta}" Style="{StaticResource LinkButton}" Click="OpenPerson_Click" Tag="{Binding Id}" Margin="0,2" ToolTip="Apri la scheda del personaggio" AutomationProperties.Name="{Binding Etichetta, StringFormat=Apri la scheda di {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="NotesCard" Style="{StaticResource SheetCard}">
                    <StackPanel>
                        <TextBlock Text="NOTE" Style="{StaticResource SheetSectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <local:RichNoteEditor x:Name="NotesText" IsReadOnly="True" AccessibleName="Note sull'opera" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SheetCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Gestisci _allegati…" Click="ManageAttachments_Click" Style="{StaticResource GhostButton}" Padding="10,4" AutomationProperties.Name="Gestisci gli allegati dell'opera" />
                            <TextBlock Text="ALLEGATI" Style="{StaticResource SheetSectionTitle}" Margin="0" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                        </DockPanel>
                        <local:AttachmentsGallery x:Name="AttachmentsView" />
                    </StackPanel>
                </Border>

                <Border x:Name="OtherWorksCard" Style="{StaticResource SheetCard}">
                    <StackPanel>
                        <TextBlock x:Name="OtherWorksTitle" Text="ALTRE OPERE DEGLI STESSI ARTISTI" Style="{StaticResource SheetSectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl x:Name="OtherWorksList" Focusable="False" AutomationProperties.Name="Altre opere degli stessi artisti">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Border DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,10,0" CornerRadius="4" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Visibility="{Binding HasMiniatura, Converter={StaticResource BoolToVisibility}}">
                                            <Image Source="{Binding Miniatura}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding Titolo, StringFormat=Miniatura di {0}}" />
                                        </Border>
                                        <Button Content="{Binding Etichetta}" Style="{StaticResource LinkButton}" Click="OpenOtherWork_Click" VerticalAlignment="Center" ToolTip="Apri la scheda dell'opera" AutomationProperties.Name="{Binding Etichetta, StringFormat='Apri l\'opera: {0}'}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SheetCard}">
                    <StackPanel>
                        <TextBlock Text="FONTI" Style="{StaticResource SheetSectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Name="NoSourcesText" Text="Nessuna fonte indicata." Style="{StaticResource SheetEmpty}" />
                        <ItemsControl x:Name="SourcesList" Focusable="False" AutomationProperties.Name="Fonti">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Button Content="{Binding Testo}" Style="{StaticResource LinkButton}" Click="OpenSource_Click" ToolTip="{Binding Url}" Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Testo, StringFormat=Apri nel browser: {0}}" />
                                        <TextBlock Text="{Binding Testo}" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0" Padding="26,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Chiudi" Click="Close_Click" IsCancel="True" Style="{StaticResource GhostButton}" Padding="16,9" Margin="8,0,0,0" />
                <Button x:Name="EditButton" DockPanel.Dock="Right" Content="_Modifica…" Click="Edit_Click" Style="{StaticResource PrimaryButton}" Padding="20,9" ToolTip="Apre l'opera nel gestore delle opere d'arte" AutomationProperties.Name="Modifica l'opera" />
                <TextBlock x:Name="StatusMessage" Foreground="{DynamicResource SignalBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
