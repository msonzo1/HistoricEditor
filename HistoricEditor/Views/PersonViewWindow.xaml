<Window x:Class="HistoricEditor.PersonViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HistoricEditor"
        Title="Scheda di lettura"
        Height="780" Width="820"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SignalBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!-- Valore in sola lettura: selezionabile e raggiungibile da tastiera; la riga sotto indica il focus. -->
        <Style x:Key="ReadOnlyValue" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style x:Key="Empty" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource QuietBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <DataTemplate x:Key="FieldTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Content="{Binding Etichetta}" Target="{Binding ElementName=Value}" Padding="0,1,10,0" VerticalAlignment="Top" />
                <TextBox x:Name="Value" Grid.Column="1" Text="{Binding Valore, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}" AutomationProperties.Name="{Binding Etichetta}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PersonLinkTemplate">
            <Button Content="{Binding Etichetta}" Style="{StaticResource LinkButton}" Click="OpenPerson_Click" Tag="{Binding Id}" Margin="0,2" ToolTip="Apri la scheda di lettura" AutomationProperties.Name="{Binding Etichetta, StringFormat=Apri la scheda di {0}}" />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="26,24,26,16">
            <Border x:Name="PortraitFrame" DockPanel.Dock="Left" Width="96" Height="120" Margin="0,0,18,0" CornerRadius="8" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Background="{DynamicResource AppSurfaceAlt}" Visibility="Collapsed">
                <Image x:Name="PortraitImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Ritratto" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" FontFamily="Georgia" FontSize="26" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="HeaderSubtitle" Foreground="{DynamicResource QuietBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,0,16,0" Focusable="False">
            <StackPanel Margin="0,0,10,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DATI PRINCIPALI" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl x:Name="MainList" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                        <TextBlock x:Name="DynastyPathText" Foreground="{DynamicResource QuietBrush}" FontSize="12" TextWrapping="Wrap" Margin="170,0,0,4" />
                    </StackPanel>
                </Border>

                <Border x:Name="LanguagesCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="NOMI IN ALTRE LINGUE" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl x:Name="LanguagesList" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="NASCITA, MORTE E SEPOLTURA" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl x:Name="LifeList" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                        <TextBlock x:Name="LifeEmptyText" Text="Nessuna data o luogo indicato." Style="{StaticResource Empty}" />
                        <Border x:Name="DateNoticePanel" Visibility="Collapsed" Margin="0,8,0,0" Background="{DynamicResource AppSurfaceAlt}" BorderBrush="{DynamicResource SignalBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <Label Content="Differenze tra le fonti" Target="{Binding ElementName=DateNoticeText}" FontWeight="SemiBold" />
                                <TextBox x:Name="DateNoticeText" Style="{StaticResource ReadOnlyValue}" FontSize="12" AutomationProperties.Name="Differenze tra le date indicate dalle fonti" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="BiographyCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="BIOGRAFIA (DA WIKIPEDIA)" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBox x:Name="BiographyText" Style="{StaticResource ReadOnlyValue}" AutomationProperties.Name="Biografia da Wikipedia" />
                    </StackPanel>
                </Border>

                <Border x:Name="NotesCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="NOTE" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <local:RichNoteEditor x:Name="NotesView" IsReadOnly="True" AccessibleName="Note sul personaggio" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="_Gestisci allegati…" Click="ManageAttachments_Click" Style="{StaticResource GhostButton}" Padding="10,4" AutomationProperties.Name="Gestisci gli allegati del personaggio" />
                            <TextBlock Text="ALLEGATI" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                        </DockPanel>
                        <local:AttachmentsGallery x:Name="AttachmentsView" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PARENTELE" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="Padre" Target="{Binding ElementName=FatherLink}" Padding="0,2,10,0" />
                            <Button x:Name="FatherLink" Grid.Column="1" Style="{StaticResource LinkButton}" Click="OpenPerson_Click" Margin="0,2" />
                            <Label Grid.Row="1" Content="Madre" Target="{Binding ElementName=MotherLink}" Padding="0,2,10,0" />
                            <Button x:Name="MotherLink" Grid.Row="1" Grid.Column="1" Style="{StaticResource LinkButton}" Click="OpenPerson_Click" Margin="0,2" />
                        </Grid>

                        <TextBlock Text="CONIUGI E FIGLI" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" AutomationProperties.HeadingLevel="Level3" />
                        <TextBlock x:Name="NoUnionsText" Text="Nessun coniuge registrato." Style="{StaticResource Empty}" />
                        <ItemsControl x:Name="UnionsList" Focusable="False" AutomationProperties.Name="Coniugi e figli">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" Background="{DynamicResource AppControlBg}">
                                        <StackPanel>
                                            <Button Content="{Binding Intestazione}" Style="{StaticResource LinkButton}" FontWeight="SemiBold" Click="OpenPerson_Click" Tag="{Binding Coniuge.Id}" IsEnabled="{Binding HasConiuge}" ToolTip="Apri la scheda di lettura del coniuge" AutomationProperties.Name="{Binding Intestazione, StringFormat=Coniuge: {0}}" />
                                            <ItemsControl ItemsSource="{Binding Figli}" ItemTemplate="{StaticResource PersonLinkTemplate}" Margin="14,4,0,0" Focusable="False" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="OtherChildrenPanel">
                            <TextBlock Text="FIGLI CON ALTRO GENITORE NON INDICATO" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" AutomationProperties.HeadingLevel="Level3" />
                            <ItemsControl x:Name="OtherChildrenList" ItemTemplate="{StaticResource PersonLinkTemplate}" Focusable="False" AutomationProperties.Name="Figli con altro genitore non indicato" />
                        </StackPanel>

                        <TextBlock Text="ALTRE RELAZIONI" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" AutomationProperties.HeadingLevel="Level3" />
                        <TextBlock x:Name="NoRelationsText" Text="Nessuna relazione registrata." Style="{StaticResource Empty}" />
                        <ItemsControl x:Name="RelationsList" Focusable="False" AutomationProperties.Name="Altre relazioni">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <Button Content="{Binding Descrizione}" Style="{StaticResource LinkButton}" Click="OpenPerson_Click" Tag="{Binding Altro.Id}" ToolTip="Apri la scheda di lettura" AutomationProperties.Name="{Binding Descrizione}" AutomationProperties.HelpText="{Binding Note}" />
                                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource QuietBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,2,0,0" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TITOLI E CARICHE" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Name="NoTitlesText" Text="Nessun titolo registrato." Style="{StaticResource Empty}" />
                        <ItemsControl x:Name="TitlesList" Focusable="False" AutomationProperties.Name="Titoli e cariche">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <Button Content="{Binding Nome}" Style="{StaticResource LinkButton}" FontWeight="SemiBold" Click="OpenTitle_Click"
                                                ToolTip="Mostra tutti i titolari di questa carica in archivio, in ordine cronologico"
                                                AutomationProperties.Name="{Binding Nome, StringFormat=Cronologia della carica: {0}}" AutomationProperties.HelpText="{Binding Dettagli}" />
                                        <TextBlock Text="{Binding Dettagli}" Foreground="{DynamicResource InkSoftBrush}" FontSize="12" TextWrapping="Wrap" Margin="14,2,0,0" Visibility="{Binding HasDettagli, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="EVENTI" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Name="NoEventsText" Text="Nessun evento collegato." Style="{StaticResource Empty}" />
                        <ItemsControl x:Name="EventsList" Focusable="False" AutomationProperties.Name="Eventi del personaggio">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Etichetta}" Style="{StaticResource LinkButton}" Click="OpenEvent_Click" Margin="0,2" ToolTip="Apri l'evento" AutomationProperties.Name="{Binding Etichetta, StringFormat='Apri l\'evento: {0}'}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="OPERE D'ARTE" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Name="NoArtworksText" Text="Nessuna opera collegata." Style="{StaticResource Empty}" />
                        <ItemsControl x:Name="ArtworksList" Focusable="False" AutomationProperties.Name="Opere d'arte collegate al personaggio">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Border DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,10,0" CornerRadius="4" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Visibility="{Binding MiniaturaVisibile}">
                                            <Image Source="{Binding Miniatura}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{Binding Titolo, StringFormat=Miniatura di {0}}" />
                                        </Border>
                                        <Button Content="{Binding Etichetta}" Style="{StaticResource LinkButton}" Click="OpenArtwork_Click" VerticalAlignment="Center" ToolTip="Apri l'opera" AutomationProperties.Name="{Binding Etichetta, StringFormat='Apri l\'opera: {0}'}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FONTI" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Name="NoSourcesText" Text="Nessuna fonte indicata." Style="{StaticResource Empty}" />
                        <ItemsControl x:Name="SourcesList" Focusable="False" AutomationProperties.Name="Fonti">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Etichetta}" Style="{StaticResource LinkButton}" Click="OpenLink_Click" Margin="0,2" ToolTip="{Binding Url}" AutomationProperties.Name="{Binding Etichetta, StringFormat=Apri nel browser: {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0" Padding="26,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Chiudi" Click="Close_Click" IsCancel="True" Style="{StaticResource GhostButton}" Padding="16,9" Margin="8,0,0,0" />
                <Button x:Name="EditButton" DockPanel.Dock="Right" Content="_Modifica…" Click="Edit_Click" Style="{StaticResource PrimaryButton}" Padding="20,9" ToolTip="Apre la scheda in modifica" AutomationProperties.Name="Modifica la scheda" />
                <TextBlock x:Name="StatusMessage" Foreground="{DynamicResource SignalBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
