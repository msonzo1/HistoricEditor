<Window x:Class="HistoricEditor.OfficesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cariche e successioni"
        Width="1180" Height="760" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <Label Content="_Cerca carica" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,3" />
                <TextBox x:Name="SearchBox" Padding="8,6" TextChanged="Search_TextChanged" AutomationProperties.Name="Cerca carica o titolo" ToolTip="Parte del nome della carica (es. re, duca, vescovo)" />
                <CheckBox x:Name="OnlyMultipleCheck" Content="Solo cariche con _più titolari" Margin="0,8,0,8" Checked="Search_TextChanged" Unchecked="Search_TextChanged" />
                <Label Content="Ca_riche" Target="{Binding ElementName=OfficeList}" Padding="0,0,0,3" />
            </StackPanel>
            <ListBox x:Name="OfficeList" HorizontalContentAlignment="Stretch" SelectionChanged="OfficeList_SelectionChanged" AutomationProperties.Name="Cariche e titoli dell’archivio">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Etichetta}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Etichetta}" TextTrimming="CharacterEllipsis" Margin="2,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="OfficeTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="OfficeSummary" Foreground="{DynamicResource QuietBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                <Label Content="Cronologia dei _titolari" Target="{Binding ElementName=ChronologyGrid}" Padding="0,8,0,3" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="OpenButton" Content="_Apri scheda" Click="Open_Click" IsEnabled="False" Padding="12,6" HorizontalAlignment="Left" AutomationProperties.Name="Apri la scheda del titolare selezionato" />
                <Label Content="Citati da Wikidata ma assenti dalla cronologia (_mancanti)" Target="{Binding ElementName=MissingList}" Padding="0,10,0,3" />
                <ListBox x:Name="MissingList" Height="96" AutomationProperties.Name="Predecessori e successori citati ma assenti dalla cronologia" AutomationProperties.HelpText="Importali da Wikipedia o aggiungi la carica alla loro scheda per completare la successione">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Etichetta}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Etichetta}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <DataGrid x:Name="ChronologyGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                      SelectionChanged="ChronologyGrid_SelectionChanged" MouseDoubleClick="ChronologyGrid_MouseDoubleClick" PreviewKeyDown="ChronologyGrid_PreviewKeyDown"
                      AutomationProperties.Name="Cronologia dei titolari" AutomationProperties.HelpText="Invio o doppio clic per aprire la scheda del titolare">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Etichetta}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N." Binding="{Binding Posizione}" Width="40" />
                    <DataGridTextColumn Header="Titolare" Binding="{Binding Titolare}" Width="1.6*" />
                    <DataGridTextColumn Header="Inizio" Binding="{Binding Inizio}" Width="1.2*" />
                    <DataGridTextColumn Header="Fine" Binding="{Binding Fine}" Width="1.2*" />
                    <DataGridTextColumn Header="Predecessore" Binding="{Binding Predecessore}" Width="1.3*" />
                    <DataGridTextColumn Header="Successore" Binding="{Binding Successore}" Width="1.3*" />
                    <DataGridTemplateColumn Header="Note" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NoteTesto}" TextWrapping="Wrap" Foreground="{DynamicResource SignalBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Chiudi" IsCancel="True" Padding="14,7" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource QuietBrush}" FontSize="11" AutomationProperties.LiveSetting="Polite"
                       Text="La successione è ricostruita dai titoli delle schede, in ordine di inizio. Le cariche con lo stesso codice Wikidata o lo stesso nome sono unite." />
        </DockPanel>
    </Grid>
</Window>
