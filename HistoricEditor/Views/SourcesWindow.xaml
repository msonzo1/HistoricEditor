<Window x:Class="HistoricEditor.SourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fonti dei dati"
        Height="380" Width="560"
        MinHeight="340" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="20,20,20,0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
            <StackPanel>
                <Label Content="Fonte delle _informazioni (URL facoltativo)" Target="{Binding ElementName=SourceUrlInput}" />
                <TextBox x:Name="SourceUrlInput" Height="34" AutomationProperties.Name="Fonte delle informazioni" />
                <Label Content="Fonti della _nascita (URL separati da ;)" Target="{Binding ElementName=BirthSourcesInput}" Margin="0,12,0,0" />
                <TextBox x:Name="BirthSourcesInput" Height="34" AutomationProperties.Name="Fonti delle ipotesi di nascita" />
                <Label Content="Fonti della _morte (URL separati da ;)" Target="{Binding ElementName=DeathSourcesInput}" Margin="0,12,0,0" />
                <TextBox x:Name="DeathSourcesInput" Height="34" AutomationProperties.Name="Fonti delle ipotesi di morte" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,20,18">
            <Button Content="Annulla" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
            <Button Content="OK" IsDefault="True" Click="Ok_Click" Padding="22,6" />
        </StackPanel>
    </Grid>
</Window>
