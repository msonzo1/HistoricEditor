<Application x:Class="HistoricEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HistoricEditor"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <ResourceDictionary Source="Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Logo: albero genealogico stilizzato su quadrato arrotondato. -->
            <DrawingImage x:Key="AppLogo">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#E8795E">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M16,24 L16,17 M16,17 L9,11 L9,9 M16,17 L23,11 L23,9">
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="2.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <EllipseGeometry Center="16,24.5" RadiusX="3.2" RadiusY="3.2" />
                                <EllipseGeometry Center="9,8" RadiusX="3.2" RadiusY="3.2" />
                                <EllipseGeometry Center="23,8" RadiusX="3.2" RadiusY="3.2" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        </ResourceDictionary>
    </Application.Resources>
</Application>
