<UserControl x:Class="HistoricEditor.PlaceDetailsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HistoricEditor"
             Foreground="{DynamicResource InkBrush}">
    <!-- Dati di un luogo attuale o storico: nella sezione Luoghi e nella finestra «Modifica luogo» del selettore. -->
    <StackPanel x:Name="EditPanel" IsEnabled="False">
        <TextBlock x:Name="PathText" Foreground="{DynamicResource InkSoftBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock x:Name="UsageText" Foreground="{DynamicResource QuietBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,-6,0,12" Visibility="Collapsed" />

        <!-- Il tipo di un luogo attuale dipende dal livello nel Paese; quello di un luogo storico si sceglie (2026-11-15). -->
        <Label Content="Tipo" Target="{Binding ElementName=TipoBox}" />
        <TextBlock x:Name="TipoText" Margin="0,0,0,10" Foreground="{DynamicResource InkBrush}" />
        <ComboBox x:Name="TipoBox" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,0,10" Visibility="Collapsed" AutomationProperties.Name="Tipo del luogo storico" />

        <Label Content="Nome" Target="{Binding ElementName=NomeBox}" />
        <TextBox x:Name="NomeBox" Margin="0,0,0,10" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label Content="Latitudine" Target="{Binding ElementName=LatBox}" />
                <TextBox x:Name="LatBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Longitudine" Target="{Binding ElementName=LonBox}" />
                <TextBox x:Name="LonBox" />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="StoricoBox" Content="Luogo storico (non più esistente)" Margin="0,0,0,10" Checked="StoricoBox_Changed" Unchecked="StoricoBox_Changed" />
        <CheckBox x:Name="SenzaLivelloBox" Margin="0,0,0,10" Visibility="Collapsed" />

        <StackPanel x:Name="PeriodoPanel" Visibility="Collapsed">
            <StackPanel x:Name="ParentPanel" Visibility="Collapsed">
                <Label Content="Contenuto in" Target="{Binding ElementName=ParentText}" />
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE70F;" Click="ChooseParent_Click" ToolTip="Scegli il luogo che contiene il luogo storico" AutomationProperties.Name="Scegli il luogo che contiene il luogo storico" />
                    <TextBox x:Name="ParentText" IsReadOnly="True" AutomationProperties.Name="Luogo che contiene il luogo storico" />
                </DockPanel>
            </StackPanel>
            <Label Content="Periodo (es. 1115–1797)" Target="{Binding ElementName=PeriodoBox}" />
            <TextBox x:Name="PeriodoBox" Margin="0,0,0,10" />
            <Expander x:Name="LatinExpander" IsExpanded="False" Margin="0,0,0,10" Foreground="{DynamicResource InkBrush}" AutomationProperties.Name="Nome in latino">
                <Expander.Header>
                    <TextBlock x:Name="LatinExpanderHeader" Text="Nome in latino" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <Label Content="Nome _latino" Target="{Binding ElementName=LatinBox}" />
                    <TextBox x:Name="LatinBox" TextChanged="LatinBox_Changed" AutomationProperties.Name="Nome latino del luogo storico" ToolTip="Per i luoghi del mondo romano, es. «Vicus Phalacrinae»" />
                </StackPanel>
            </Expander>
        </StackPanel>

        <DockPanel Margin="0,4,0,0">
            <Button x:Name="WikidataNamesButton" DockPanel.Dock="Right" Content="Da _Wikidata…" Click="WikidataNames_Click" Padding="10,4" Margin="6,0,0,0"
                    ToolTip="Cerca su Wikidata i nomi che il luogo ha avuto nel tempo e li aggiunge all’elenco" AutomationProperties.Name="Importa i nomi storici da Wikidata" />
            <Button DockPanel.Dock="Right" Content="Rimuovi" Click="RemoveHistoricName_Click" Padding="10,4" Margin="6,0,0,0" AutomationProperties.Name="Rimuovi il nome storico selezionato" />
            <Button DockPanel.Dock="Right" Content="Aggiungi" Click="AddHistoricName_Click" Padding="10,4" AutomationProperties.Name="Aggiungi un nome storico" />
            <Label Content="Nomi _storici" Target="{Binding ElementName=HistoricNamesGrid}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="Nomi usati in passato, es. «Costantinopoli» dal 330 al 1922. Anni a.C. come «667 a.C.» o «-667». Nelle schede compare il nome dell’epoca."
                   Foreground="{DynamicResource QuietBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6" />
        <DataGrid x:Name="HistoricNamesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True" HeadersVisibility="Column" SelectionMode="Single"
                  MinHeight="60" MaxHeight="200" Margin="0,0,0,12" AutomationProperties.Name="Nomi storici del luogo">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                <DataGridTextColumn Header="Dal" Binding="{Binding Dal, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTextColumn Header="Al" Binding="{Binding Al, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTextColumn Header="Fonte" Binding="{Binding Fonte, UpdateSourceTrigger=PropertyChanged}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Label Content="_Note" Target="{Binding ElementName=NoteEditor}" />
        <local:RichNoteEditor x:Name="NoteEditor" AccessibleName="Note sul luogo" EditorHeight="110" Margin="0,0,0,12" />

        <Button x:Name="SaveButton" Content="Salva modifiche" Click="Save_Click" Padding="12,7" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" />

        <DockPanel Margin="0,18,0,8">
            <Button DockPanel.Dock="Right" Content="_Allegati…" Click="Attachments_Click" Padding="10,4" AutomationProperties.Name="Gestisci gli allegati del luogo" />
            <TextBlock Text="ALLEGATI" Foreground="{DynamicResource SignalBrush}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level3" />
        </DockPanel>
        <local:AttachmentsGallery x:Name="AttachmentsView" />
    </StackPanel>
</UserControl>
