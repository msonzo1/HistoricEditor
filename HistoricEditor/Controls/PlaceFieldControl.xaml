<UserControl x:Class="HistoricEditor.PlaceFieldControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	 <UserControl.Resources>
		  <Style x:Key="PlaceValueBox" TargetType="Border">
				<Setter Property="Height" Value="34" />
				<Setter Property="Padding" Value="10,0" />
				<Setter Property="CornerRadius" Value="6" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
				<Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}" />
		  </Style>
		  <Style x:Key="PlaceIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
				<Setter Property="Width" Value="34" />
				<Setter Property="Height" Value="34" />
				<Setter Property="Margin" Value="6,0,0,0" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
				<Setter Property="FontSize" Value="13" />
		  </Style>
	 </UserControl.Resources>
	 <StackPanel>
        <Label x:Name="TitleLabel" Target="{Binding ElementName=EditButton}" />
		  <DockPanel>
				<Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource PlaceIconButton}" Content="&#xE738;" Click="Clear_Click" ToolTip="Rimuovi il luogo da questo personaggio" />
				<Button x:Name="EditButton" DockPanel.Dock="Right" Style="{StaticResource PlaceIconButton}" Content="&#xE70F;" Click="Edit_Click" ToolTip="Modifica il luogo" />
				<Border Style="{StaticResource PlaceValueBox}">
					 <TextBlock x:Name="ClassicText" Text="Nessun luogo selezionato" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
				</Border>
		  </DockPanel>
		  <DockPanel x:Name="SpecificRow" Visibility="Collapsed" Margin="0,6,0,0">
				<Button x:Name="ClearSpecificButton" DockPanel.Dock="Right" Style="{StaticResource PlaceIconButton}" Content="&#xE738;" Click="ClearSpecific_Click" ToolTip="Rimuovi il luogo specifico" />
				<Button x:Name="SpecificButton" DockPanel.Dock="Right" Style="{StaticResource PlaceIconButton}" Content="&#xE70F;" Click="Specific_Click" ToolTip="Aggiungi o modifica il luogo specifico" />
				<Border Style="{StaticResource PlaceValueBox}">
					 <TextBlock x:Name="SpecificText" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
				</Border>
		  </DockPanel>

        <CheckBox x:Name="HistoricToggle" Content="Aggiungi contesto storico" Margin="0,8,0,0" Checked="HistoricToggle_Changed" Unchecked="HistoricToggle_Changed" />
        <StackPanel x:Name="HistoricPanel" Visibility="Collapsed">
            <Label Content="Nome del luogo all’epoca" Target="{Binding ElementName=HistoricNameInput}" Margin="0,9,0,0" />
            <TextBox x:Name="HistoricNameInput" />
            <Label Content="Entità politica storica (es. Repubblica di Genova)" Target="{Binding ElementName=PolityInput}" Margin="0,9,0,0" />
            <TextBox x:Name="PolityInput" />
            <Grid Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Label Content="Unità dell’epoca" Target="{Binding ElementName=HistoricAdminInput}" />
                    <TextBox x:Name="HistoricAdminInput" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="Periodo" Target="{Binding ElementName=PeriodInput}" />
                    <TextBox x:Name="PeriodInput" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
