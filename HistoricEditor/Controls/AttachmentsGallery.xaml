<UserControl x:Class="HistoricEditor.AttachmentsGallery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="EmptyText" Text="Nessun allegato." Style="{StaticResource SheetEmpty}" />
        <ItemsControl x:Name="Items" Focusable="False" AutomationProperties.Name="Allegati">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Click="Open_Click" Tag="{Binding}" Width="132" Margin="0,0,10,10" Padding="6" ToolTip="{Binding Dettaglio}"
                            AutomationProperties.Name="{Binding Etichetta, StringFormat=Apri l’allegato: {0}}">
                        <StackPanel>
                            <Border Height="96" CornerRadius="4" Background="{DynamicResource AppSurfaceAlt}">
                                <Grid>
                                    <Image Source="{Binding Miniatura}" Stretch="Uniform" />
                                    <TextBlock Text="{Binding Estensione}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{DynamicResource QuietBrush}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Titolo}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Allegato.Data}" FontSize="11" Foreground="{DynamicResource QuietBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="Message" Foreground="{DynamicResource SignalBrush}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
